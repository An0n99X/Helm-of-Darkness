---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Helm of Darkness",
  description = "Security research and technical vulnerability writeups by Anubhav Dash, including analysis, proof-of-concept evidence, disclosure, and fixes.",
  image,
} = Astro.props;
const pageTitle = title === "Helm of Darkness" ? title : `${title} · Helm of Darkness`;
const socialImage = image ? new URL(image, Astro.site) : undefined;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b0d" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon-mythosaur.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-ink text-paper antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a class="brand" href={base} aria-label="Helm of Darkness home">
          <img class="brand-mark" src={`${base}images/mythosaur-mark.svg`} alt="" aria-hidden="true" />
          <span>HELM <span class="brand-muted">OF DARKNESS</span></span>
        </a>
        <nav class="flex items-center gap-7" aria-label="Main navigation">
          <a class="nav-link" href={`${base}#research`}>Research</a>
          <a class="nav-link nav-github" href="https://github.com/AnubhavDash" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-6 py-8 sm:flex-row sm:items-center sm:justify-between lg:px-10">
        <p>Research by <a href="https://github.com/AnubhavDash">Anubhav Dash</a>.</p>
        <p class="footer-note"><a class="social-link" href="https://x.com/An0n99X" target="_blank" rel="noreferrer" aria-label="Anubhav Dash on X, @An0n99X">
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19 9.456 12.504h-7.406l-5.8-7.584-6.635 7.584h-3.68l8.6-9.83L.4 1.153h7.594l5.242 6.93zm-1.29 19.49h2.039L6.48 3.24H4.292z" /></svg>
          <span>@An0n99X</span>
        </a></p>
      </div>
    </footer>
  </body>
</html>
