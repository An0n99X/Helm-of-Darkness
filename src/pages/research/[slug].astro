---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <main id="main" class="article-page mx-auto max-w-7xl px-6 py-12 lg:px-10 lg:py-20">
    <a class="back-link" href={`${base}research/`}>← Research archive</a>
    <header class="article-header">
      <p class="eyebrow">FIELD REPORT / {post.data.tags.slice(0, 2).join(" · ").toUpperCase()}</p>
      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      <div class="article-meta"><span>By Anubhav Dash</span><span>·</span><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time><span>·</span><span>{headings.filter((heading) => heading.depth === 2).length} sections</span></div>
    </header>

    {post.data.findings.length > 0 && <section class="finding-summary" aria-label="Vulnerability summary">
      <div class="finding-summary-heading"><span class="eyebrow">AT A GLANCE</span><span>{post.data.findings.length} vulnerabilities</span></div>
      <div class="finding-grid">
        {post.data.findings.map((finding) => <a class="finding-card" href={finding.url} target="_blank" rel="noreferrer"><span class={`severity-badge ${finding.severity.toLowerCase()}`}>{finding.severity}</span><strong>{finding.name}</strong><span class="finding-score">{finding.score} <span aria-hidden="true">↗</span></span></a>)}
      </div>
    </section>}

    <div class="article-layout">
      <aside class="article-sidebar" aria-label="Article contents">
        <p class="eyebrow">IN THIS REPORT</p>
        <nav><ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
        <a class="sidebar-source" href="https://github.com/AnubhavDash/Helm-of-Darkness/tree/main/src/content/posts" target="_blank" rel="noreferrer">Browse Markdown posts ↗</a>
      </aside>
      <article class="article-content"><Content /></article>
    </div>
    <div class="article-end"><span class="end-star" aria-hidden="true">✳</span><p>End of report</p><a class="text-link" href={`${base}research/`}>Back to the research index <span aria-hidden="true">→</span></a></div>
  </main>
</SiteLayout>
