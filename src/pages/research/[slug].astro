---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
---

<SiteLayout title={post.data.title} description={post.data.description}>
  <main id="main" class="article-page mx-auto max-w-7xl px-6 py-12 lg:px-10 lg:py-20">
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <a class="back-link" href={`${base}research/`}>← Research archive</a>
    <header class="article-header">
      <p class="eyebrow">FIELD REPORT / {post.data.tags.slice(0, 2).join(" · ").toUpperCase()}</p>
      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      <div class="article-meta"><span>By Anubhav Dash</span><span>·</span><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time></div>
    </header>

    {post.data.findings.length > 0 && <section class="finding-summary" aria-label="Vulnerability summary">
      <div class="finding-summary-heading"><span class="eyebrow">AT A GLANCE</span><span>{post.data.findings.length} vulnerabilities</span></div>
      <div class="finding-grid">
        {post.data.findings.map((finding) => <a class="finding-card" href={finding.url} target="_blank" rel="noreferrer"><span class={`severity-badge ${finding.severity.toLowerCase()}`}>{finding.severity}</span><strong>{finding.name}</strong><span class="finding-score">{finding.score} <span aria-hidden="true">↗</span></span></a>)}
      </div>
    </section>}

    <div class="article-layout">
      <aside class="article-sidebar" aria-label="Article contents">
        <p class="eyebrow">IN THIS REPORT</p>
        <nav><ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
      </aside>
      <article class="article-content"><Content /></article>
    </div>
    <div class="article-end"><span class="end-star" aria-hidden="true">✳</span><p>End of report</p><a class="text-link" href={`${base}research/`}>Back to the research index <span aria-hidden="true">→</span></a></div>
  </main>
</SiteLayout>

<script>
  const tocLinks = [...document.querySelectorAll(".article-sidebar nav a")];
  const tocHeadings = tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading) => heading !== null);

  function setActiveSection(id) {
    for (const link of tocLinks) {
      const active = decodeURIComponent(link.hash.slice(1)) === id;
      link.classList.toggle("is-active", active);
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
      if (active && window.matchMedia("(max-width: 640px)").matches) {
        const nav = link.closest("nav");
        if (nav) {
          const navBounds = nav.getBoundingClientRect();
          const linkBounds = link.getBoundingClientRect();
          if (linkBounds.left < navBounds.left) nav.scrollLeft -= navBounds.left - linkBounds.left;
          else if (linkBounds.right > navBounds.right) nav.scrollLeft += linkBounds.right - navBounds.right;
        }
      }
    }
  }

  if (tocHeadings.length) {
    setActiveSection(decodeURIComponent(location.hash.slice(1)) || tocHeadings[0].id);

    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible.length) setActiveSection(visible[0].target.id);
    }, { rootMargin: "-14% 0px -74% 0px", threshold: 0 });

    tocHeadings.forEach((heading) => sectionObserver.observe(heading));
    tocLinks.forEach((link) => link.addEventListener("click", () => {
      setActiveSection(decodeURIComponent(link.hash.slice(1)));
    }));
    window.addEventListener("hashchange", () => {
      setActiveSection(decodeURIComponent(location.hash.slice(1)));
    });
  }

  const progressBar = document.querySelector(".reading-progress span");
  let progressFrame = 0;

  function updateReadingProgress() {
    if (!progressBar || progressFrame) return;
    progressFrame = requestAnimationFrame(() => {
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
      progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      progressFrame = 0;
    });
  }

  window.addEventListener("scroll", updateReadingProgress, { passive: true });
  window.addEventListener("resize", updateReadingProgress);
  updateReadingProgress();
</script>
