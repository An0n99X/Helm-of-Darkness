---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
---

<SiteLayout image={`${base}images/milky-way.webp`} preloadImage={`${base}images/milky-way.webp`}>
  <main id="main">
    <section class="home-hero mx-auto max-w-7xl px-6 pt-4 lg:px-10">
      <div class="hero-frame">
        <img class="hero-image" src={`${base}images/milky-way.webp`} alt="The Milky Way above a quiet mountain ridge" width="800" height="551" fetchpriority="high" decoding="async" />
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <h1>Under this wide sky,<br /><span>there's always more</span></h1>
          <p class="hero-description">Independent security research on blockchain nodes, virtual machines, and the bugs that make them misbehave.</p>
          <a class="hero-audit-cta" href="https://x.com/An0n99X" target="_blank" rel="noreferrer" aria-label="Contact Anubhav Dash on X about security research or a review">
            <span class="hero-audit-copy"><strong>Let’s find what your tests missed.</strong><span>Go nodes · VMs · Consensus · DM me on X</span></span>
            <span class="hero-audit-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
