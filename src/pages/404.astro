---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Page not found">
  <main id="main" class="not-found mx-auto max-w-7xl px-6 py-32 lg:px-10">
    <p class="eyebrow">404 / LOST IN THE DARK</p>
    <h1>This page drifted<br /><span>out of orbit.</span></h1>
    <a class="text-link" href={base}>Return to the homepage <span aria-hidden="true">→</span></a>
  </main>
</SiteLayout>
